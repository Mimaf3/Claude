generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          String    // "secretaire" | "manip_radio" | "medecin" | "admin"
  speciality    String?
  rppsNumber    String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  acceptedVacations  Vacation[]           @relation("AcceptedBy")
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  sitePreferences    UserSitePreference[]
}

model Site {
  id          String    @id @default(cuid())
  name        String
  address     String
  city        String
  zipCode     String
  phone       String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vacations       Vacation[]
  sitePreferences UserSitePreference[]
}

model Vacation {
  id           String    @id @default(cuid())
  title        String
  description  String?
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id])
  requiredRole String    // "secretaire" | "manip_radio" | "medecin"
  speciality   String?
  startDate    DateTime
  endDate      DateTime
  status       String    @default("available") // "available" | "taken" | "cancelled"
  takenById    String?
  takenBy      User?     @relation("AcceptedBy", fields: [takenById], references: [id])
  takenAt      DateTime?
  hourlyRate   Float?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notifications Notification[]
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  vacationId String?
  vacation   Vacation? @relation(fields: [vacationId], references: [id])
  type       String    // "new_vacation" | "vacation_cancelled" | "vacation_available_again"
  title      String
  message    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model UserSitePreference {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  siteId  String
  site    Site    @relation(fields: [siteId], references: [id])
  enabled Boolean @default(true)

  @@unique([userId, siteId])
}
